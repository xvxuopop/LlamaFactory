+def _build_zero3_streaming_conversion_plan(model, source_keys, weight_mapping):
+    """Plan one-to-one renames/transposes without materializing converted tensors.
+
+    More complex conversions retain the existing eager loader. In particular,
+    fusion/splitting operations may span modules and cannot be streamed using
+    this module-local plan without changing their dependency order.
+    """
+    from ..core_model_loading import Transpose, WeightConverter, WeightRenaming, dot_natural_key, rename_source_key
+
+    renamings = [entry for entry in weight_mapping if isinstance(entry, WeightRenaming)]
+    converters = [entry for entry in weight_mapping if isinstance(entry, WeightConverter)]
+    if len(renamings) + len(converters) != len(weight_mapping):
+        return None
+    if any(
+        len(converter.source_patterns) != 1
+        or len(converter.target_patterns) != 1
+        or len(converter.operations) != 1
+        or not isinstance(converter.operations[0], Transpose)
+        or converter.quantization_operation is not None
+        or converter.distributed_operation is not None
+        for converter in converters
+    ):
+        return None
+
+    ds_config = deepspeed_config() or {}
+    inference_config = ds_config.get("inference", {})
+    tp_size = ds_config.get("tensor_parallel", {}).get("autotp_size", 1)
+    if isinstance(inference_config, dict):
+        tp_size = max(tp_size, inference_config.get("tensor_parallel", {}).get("tp_size", 1))
+    if tp_size > 1:
+        return None  # The eager path reports the existing unsupported-TP error.
+
+    model_state = model.state_dict()
+    if any(not isinstance(value, torch.Tensor) for value in model_state.values()):
+        return None  # Preserve custom extra-state loading on the eager path.
+    by_pattern = {pattern: converter for converter in converters for pattern in converter.source_patterns}
+    plan = {}
+    for source_key in sorted(source_keys, key=dot_natural_key):
+        target_key, source_pattern = rename_source_key(
+            source_key, renamings, converters, model.base_model_prefix, model_state
+        )
+        if target_key not in model_state:
+            continue
+        if target_key in plan:
+            return None  # Several sources for one target require the eager collector.
+        plan[target_key] = (source_key, source_pattern, by_pattern.get(source_pattern))
+    return plan
+
+
+def _convert_zero3_module_state_dict(model, keys, source_state_dict, conversion_plan):
+    """Materialize at most one module's converted checkpoint tensors on rank 0."""
+    from ..core_model_loading import WeightConverter
+
+    result = {}
+    for target_key in keys:
+        source_key, source_pattern, converter = conversion_plan[target_key]
+        tensor = source_state_dict.pop(source_key)
+        if converter is None:
+            result[target_key] = tensor
+            continue
+        mapping = WeightConverter(
+            source_patterns=converter.source_patterns,
+            target_patterns=converter.target_patterns,
+            operations=converter.operations,
+        )
+        mapping.add_tensor(target_key, source_key, source_pattern, tensor)
+        realized = mapping.convert(target_key, model=model, config=model.config)
+        if set(realized) != {target_key}:
+            raise RuntimeError(
+                f"Streaming conversion for '{target_key}' produced unexpected targets: {list(realized)}"
+            )
+        value = realized[target_key]
+        if isinstance(value, list):
+            if len(value) != 1:
+                raise RuntimeError(f"Streaming conversion for '{target_key}' produced {len(value)} tensors")
+            value = value[0]
+        result[target_key] = value
+    return result
+
